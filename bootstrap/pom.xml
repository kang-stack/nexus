<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>cn.cloudcat</groupId>
        <artifactId>cat-customer-agent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>bootstrap</artifactId>
    <packaging>jar</packaging>
    <description>启动模块</description>

    <dependencies>
        <dependency>
            <groupId>cn.cloudcat</groupId>
            <artifactId>user-message</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cloudcat</groupId>
            <artifactId>user-diagnosis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cloudcat</groupId>
            <artifactId>user-session</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cloudcat</groupId>
            <artifactId>cs-assistant</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cloudcat</groupId>
            <artifactId>user-portal</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cloudcat</groupId>
            <artifactId>common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cloudcat</groupId>
            <artifactId>common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
