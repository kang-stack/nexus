    <dependencies>
        <dependency>
            <groupId>cn.cloudcat</groupId>
            <artifactId>user-common</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cloudcat</groupId>
            <artifactId>ai-spi</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.cloudcat</groupId>
            <artifactId>user-knowledge</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.cloudcat</groupId>
            <artifactId>user-diagnosis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
